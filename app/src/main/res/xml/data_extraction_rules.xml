<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the guard's Telegram bot token stays on the phone (not in backups or transfers). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jarvis_guard.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jarvis_guard.xml" />
    </device-transfer>
</data-extraction-rules>
