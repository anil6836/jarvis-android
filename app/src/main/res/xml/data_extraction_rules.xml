<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the guard's Telegram bot token and the faces Jarvis knows stay on the phone (not in backups or transfers). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jarvis_guard.xml" />
        <exclude domain="sharedpref" path="jarvis_people.xml" />
        <exclude domain="file" path="facenet.tflite" />
        <exclude domain="file" path="read_later/" />
        <exclude domain="sharedpref" path="jarvis_read_later.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jarvis_guard.xml" />
        <exclude domain="sharedpref" path="jarvis_people.xml" />
        <exclude domain="file" path="facenet.tflite" />
        <exclude domain="file" path="read_later/" />
        <exclude domain="sharedpref" path="jarvis_read_later.xml" />
    </device-transfer>
</data-extraction-rules>
