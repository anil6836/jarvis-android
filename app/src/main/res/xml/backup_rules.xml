<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: the guard's Telegram bot token and the faces Jarvis knows stay out of Google's backup (they are in
     his own password-locked Drive backup); the big re-downloadable models and recordings are left out, so the rest fits
     Google's 25 MB (over it, Google backs up nothing at all). -->
<full-backup-content>
    <exclude domain="sharedpref" path="jarvis_guard.xml" />
    <exclude domain="sharedpref" path="jarvis_people.xml" />
    <exclude domain="file" path="facenet.tflite" />
    <exclude domain="file" path="jarvis_trips.json" />
    <exclude domain="file" path="jarvis_trips.json.part" />
    <exclude domain="sharedpref" path="calls_private.xml" />
    <exclude domain="sharedpref" path="car_cam_private.xml" />
        <exclude domain="file" path="car_wall.jpg" />
        <exclude domain="file" path="car_photo.jpg" />
        <exclude domain="file" path="car_rear.jpg" />
        <exclude domain="file" path="car_top.jpg" />
        <exclude domain="file" path="car_wall.jpg.part" />
        <exclude domain="file" path="car_photo.jpg.part" />
        <exclude domain="file" path="car_rear.jpg.part" />
        <exclude domain="file" path="car_top.jpg.part" />
        <exclude domain="file" path="car3d_front" />
        <exclude domain="file" path="car3d_front.part" />
        <exclude domain="file" path="car3d_rear" />
        <exclude domain="file" path="car3d_rear.part" />
        <exclude domain="file" path="car3d_left" />
        <exclude domain="file" path="car3d_left.part" />
        <exclude domain="file" path="car3d_right" />
        <exclude domain="file" path="car3d_right.part" />
        <exclude domain="file" path="car3d_top" />
        <exclude domain="file" path="car3d_top.part" />
        <exclude domain="file" path="car3d_rear_left" />
        <exclude domain="file" path="car3d_rear_left.part" />
        <exclude domain="file" path="car3d_rear_right" />
        <exclude domain="file" path="car3d_rear_right.part" />
        <exclude domain="file" path="world3d/" />
    <exclude domain="file" path="read_later/" />
    <exclude domain="sharedpref" path="jarvis_read_later.xml" />
    <exclude domain="sharedpref" path="jarvis_later_msgs.xml" />
    <exclude domain="sharedpref" path="jarvis_read_places.xml" />
    <exclude domain="sharedpref" path="jarvis_scans.xml" />
    <exclude domain="sharedpref" path="jarvis_mic_quiet.xml" />
    <exclude domain="file" path="scans/" />
        <exclude domain="file" path="bible/" />
        <exclude domain="file" path="vosk-en/" />
        <exclude domain="file" path="vosk-spk/" />
        <exclude domain="file" path=".jarvis_restore/" />
        <exclude domain="file" path=".jarvis_old/" />
        <exclude domain="external" path=".jarvis_restore/" />
        <exclude domain="external" path=".jarvis_old/" />
        <exclude domain="sharedpref" path="jarvis_backup.xml" />
        <exclude domain="external" path="recordings/" />
        <exclude domain="external" path="Download/" />
</full-backup-content>
