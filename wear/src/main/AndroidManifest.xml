<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- W20: steps, so "phone forgotten" comes only when he walks on without it -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- phase 4: the heart rate now and then while he sits (stress, fever hint, resting rate), the body scan, the breathing;
         the steps and the heart rate keep going in the background ("health" service) -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- W33: a watch timer ends on time (it is an alarm-clock kind of app for that) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- W36: Jarvis's radio played by the watch itself -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- the watch's own speech service (Google voice typing), when it has one -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/JarvisWatch"
        android:networkSecurityConfig="@xml/network_security_config">

        <uses-library android:name="com.google.android.wearable" android:required="false" />
        <!-- needs the phone's Jarvis (it thinks; the watch is its remote) -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />
        <!-- Jarvis's phone notifications come through this app (with Jarvis's own vibrations), not copied as well -->
        <meta-data android:name="com.google.android.wearable.notificationBridgeMode" android:value="NO_BRIDGING" />

        <activity
            android:name=".WatchActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- W19: Jarvis's alarm, a vibration on the wrist -->
        <activity
            android:name=".AlarmScreen"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.anil.jarvis.watch.alarm"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- phase 3: the day's screens (status, duty, tasks, home, timer, cooker); opened by the Jarvis tile too -->
        <activity
            android:name=".Panel"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- phase 4: the body scan (W25) and the breathing with vibration (W30) -->
        <activity
            android:name=".Scan"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop" />
        <activity
            android:name=".Breathe"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- phase 5: the arrow to the bike / home (W52) and the walking route (W51) -->
        <activity
            android:name=".Compass"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- W21: the Jarvis tile -->
        <service
            android:name=".JarvisTile"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Jarvis"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/tile_preview" />
        </service>

        <!-- W33: a watch timer ended -->
        <receiver
            android:name=".Timers"
            android:exported="false" />

        <!-- W1: short texts for watch faces (the Jarvis face, or any face): next duty, weather -->
        <service
            android:name=".DutySource"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Jarvis డ్యూటీ"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="600" />
        </service>
        <service
            android:name=".WeatherSource"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Jarvis వాతావరణం"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="1800" />
        </service>

        <!-- W61: today's stress and the phone's battery for any watch face -->
        <service
            android:name=".StressSource"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Jarvis ఒత్తిడి"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="1800" />
        </service>
        <service
            android:name=".PhoneSource"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Jarvis ఫోన్ బ్యాటరీ"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="900" />
        </service>

        <!-- keeps the watch ready to listen when the wrist is raised (and in his chosen hours); phase 4: steps, heart rate -->
        <service
            android:name=".EarService"
            android:exported="false"
            android:foregroundServiceType="microphone|health" />

        <!-- W56: a recording on the watch, written out on the phone -->
        <activity
            android:name=".Recorder"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop" />
        <service
            android:name=".RecService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- W66 find the watch, W71 counting an exercise -->
        <activity
            android:name=".FindWatch"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.anil.jarvis.watch.find"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <activity
            android:name=".Reps"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- W54: pictures from the phone -->
        <activity
            android:name=".Photos"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- W40 / W42: 🆘 and "బాగున్నారా?" after a fall -->
        <activity
            android:name=".Help"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.anil.jarvis.watch.help"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- W36: the radio on the watch -->
        <service
            android:name=".RadioPlayer"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- messages from the phone's Jarvis -->
        <service
            android:name=".Inbox"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/jarvis" />
            </intent-filter>
            <!-- the phone's Jarvis coming into / going out of reach ("phone forgotten", W20) -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/jarvis_phone" />
            </intent-filter>
        </service>

        <receiver
            android:name=".Beat"
            android:exported="false" />

        <receiver
            android:name=".Answer"
            android:exported="false" />

        <receiver
            android:name=".Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
